---
interface Props {
    title: string;
    description?: string;
    wide?: boolean;
    compact?: boolean;
}
const { title, description = 'A simple tool for logging and viewing data points over time.', wide = false, compact = false } = Astro.props;
const ogImage = new URL('/images/og-image.png', Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <style is:global>
        :root {
            --primary: #1e4620;
            --accent: #b8860b;
            --border: #d8e2d8;
            --text: #222;
            --text-light: #666;
            /* Data-mark colors: calibrated steps of the brand hue for chart use
               (validated for CVD separation + contrast), distinct from --primary/
               --accent which are UI chrome/ink. */
            --chart-green: #1f7a3d;
            --chart-gold: #b8860b;
            --chart-grid: #e6e9e6;
            --chart-axis: #8a938a;
        }
        * { box-sizing: border-box; }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background: #f5f8f5;
            color: var(--text);
            margin: 0;
        }
        .page {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem;
        }
        .page.wide {
            max-width: 1300px;
        }
        .page.compact {
            padding: 1rem 1.5rem 1rem;
        }
        @media (max-width: 600px) {
            .page { padding: 1.25rem 1rem 3rem; }
            .page.compact { padding: 0.6rem 0.75rem 0.6rem; }
            .form-row { grid-template-columns: 1fr; gap: 0; }
        }
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }
        .top-bar a {
            color: var(--text-light);
            text-decoration: none;
            font-size: 0.9rem;
        }
        .top-bar a:hover { color: var(--primary); }
        h1 { color: var(--primary); margin: 0 0 0.5rem; }
        .btn {
            display: inline-block;
            background: var(--accent);
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.6rem 1.2rem;
            border-radius: 4px;
            border: none;
            cursor: pointer;
        }
        .btn:hover { opacity: 0.92; }
        .btn-secondary {
            background: #fff;
            color: var(--text);
            border: 1px solid var(--border);
        }
        .btn-danger {
            background: #fff;
            color: #991b1b;
            border: 1px solid #f3caca;
        }
        .card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem 1.5rem;
        }
        label {
            display: block;
            font-weight: 600;
            color: var(--primary);
            font-size: 0.85rem;
            margin-bottom: 0.35rem;
        }
        input, textarea {
            width: 100%;
            padding: 0.6rem 0.75rem;
            border: 1px solid var(--border);
            border-radius: 4px;
            font-family: inherit;
            font-size: 0.95rem;
        }
        input:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
        }
        .form-group { margin-bottom: 1.1rem; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .status-message {
            margin-top: 1rem;
            padding: 0.75rem 1rem;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 500;
            display: none;
        }
        .status-message.success { background: #d1fae5; color: #065f46; display: block; }
        .status-message.error { background: #fee2e2; color: #991b1b; display: block; }

        .chart-tooltip-el {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 50;
            pointer-events: none;
            background: #1e4620;
            color: #fff;
            border-radius: 8px;
            padding: 0.65rem 0.85rem;
            font-size: 0.92rem;
            line-height: 1.45;
            box-shadow: 0 6px 20px rgba(0,0,0,0.25);
            opacity: 0;
            max-width: min(280px, calc(100vw - 24px));
        }
        .chart-tooltip-el .ct-title {
            font-weight: 700;
            font-size: 0.8rem;
            color: #cfe3d0;
            margin-bottom: 0.35rem;
            letter-spacing: 0.02em;
        }
        .chart-tooltip-el .ct-row {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .chart-tooltip-el .ct-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .chart-tooltip-el .ct-note {
            margin-top: 0.3rem;
            padding-top: 0.3rem;
            border-top: 1px solid rgba(255,255,255,0.2);
            font-weight: 500;
            font-style: italic;
            color: #e8f0e8;
            white-space: normal;
        }
    </style>
</head>
<body>
    <div class:list={['page', { wide, compact }]}>
        <slot />
    </div>
</body>
</html>
