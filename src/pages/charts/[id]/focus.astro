---
import Layout from '../../../layouts/Layout.astro';
import { getDB } from '../../../lib/db/client';
import { getChartById, getEntriesForChart } from '../../../lib/db/chart-queries';

const { id } = Astro.params;
const chartId = Number(id);
const db = getDB(Astro.locals.runtime?.env);
const chart = await getChartById(db, chartId);

if (!chart) {
    return Astro.redirect('/');
}

const entries = await getEntriesForChart(db, chartId);
const latest = entries.length > 0 ? entries[entries.length - 1] : null;
const goalDiff = chart.goal_score !== null && latest ? Math.abs(latest.score - chart.goal_score) : null;

const pointCount = `${entries.length} data point${entries.length === 1 ? '' : 's'}`;
const description = chart.goal_score !== null && latest
    ? `${pointCount} · Latest ${chart.y_axis_label}: ${latest.score} · Goal: ${chart.goal_score}`
    : latest
        ? `${pointCount} · Latest ${chart.y_axis_label}: ${latest.score}`
        : `${chart.x_axis_label} vs ${chart.y_axis_label}, ${chart.date_start} to ${chart.date_end}`;
---

<Layout title={`${chart.title} | Chart Tracker`} description={description} wide compact>
    <div class="focus-header">
        <div>
            <h1>{chart.title}</h1>
            {chart.goal_score !== null && (
                <p class="goal-line">
                    &#127919; Goal: {chart.goal_score}{chart.goal_date && <> by {chart.goal_date}</>}
                    {latest && <> &middot; Latest: {latest.score} ({goalDiff} from goal)</>}
                </p>
            )}
        </div>
        <div class="focus-actions">
            <button type="button" id="share-btn" class="btn btn-secondary">Share</button>
            <a href={`/charts/${chart.id}`} class="btn btn-secondary">&larr; Back to Chart</a>
        </div>
    </div>

    <div class="card focus-card">
        <div class="chart-shell">
            <button type="button" class="chart-nav chart-nav-left" id="chart-nav-left" aria-label="Scroll chart left">&#8249;</button>
            <div class="chart-wrap focus-chart-wrap">
                <div class="chart-sizer">
                    <canvas id="chart-canvas"></canvas>
                </div>
            </div>
            <button type="button" class="chart-nav chart-nav-right" id="chart-nav-right" aria-label="Scroll chart right">&#8250;</button>
        </div>
    </div>

    {entries.length === 0 ? (
        <div class="card slideshow-card">
            <p style="color: var(--text-light); margin: 0;">No data points yet.</p>
        </div>
    ) : (
        <div class="card slideshow-card" id="slideshow-card">
            <div class="slide-progress"><div class="slide-progress-fill" id="slide-progress-fill"></div></div>
            <p class="slide-counter" id="slide-counter"></p>

            <div class="slide-body" aria-live="polite">
                <p class="slide-date" id="slide-date"></p>
                <div class="slide-score-row">
                    <span class="slide-score" id="slide-score"></span>
                    <span class="slide-unit" id="slide-unit"></span>
                </div>
                <div class="slide-badges" id="slide-badges"></div>
                <p class="slide-annotation" id="slide-annotation"></p>
            </div>

            <div class="slide-controls">
                <button type="button" id="slide-prev" class="slide-btn" aria-label="Previous point">&#8249;</button>
                <button type="button" id="slide-playpause" class="slide-btn slide-btn-primary" aria-label="Play">&#9654;</button>
                <button type="button" id="slide-next" class="slide-btn" aria-label="Next point">&#8250;</button>
            </div>
        </div>
    )}
</Layout>

<script define:vars={{ chart, entries }}>
    window.__CHART_DATA__ = chart;
    window.__CHART_ENTRIES__ = entries;
</script>

<script>
import { renderChart, setActivePoint } from '../../../lib/render-chart';

const chartData = (window as any).__CHART_DATA__;
const entries = (window as any).__CHART_ENTRIES__ as { entry_date: string; score: number; annotation: string | null }[];

const canvas = document.getElementById('chart-canvas') as HTMLCanvasElement;
const chartInstance = renderChart(canvas, chartData, entries);

// ── Share ─────────────────────────────────────────────────────────────
const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;
shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    if (navigator.share) {
        try { await navigator.share({ title: chartData.title, url }); } catch { /* user cancelled */ }
        return;
    }
    try {
        await navigator.clipboard.writeText(url);
        const original = shareBtn.textContent;
        shareBtn.textContent = 'Link copied!';
        setTimeout(() => { shareBtn.textContent = original; }, 2000);
    } catch {
        window.prompt('Copy this link:', url);
    }
});

// ── Slideshow ─────────────────────────────────────────────────────────
if (entries.length > 0) {
    const scores = entries.map((e) => e.score);
    const maxScore = Math.max(...scores);
    const minScore = Math.min(...scores);

    const dateEl = document.getElementById('slide-date')!;
    const scoreEl = document.getElementById('slide-score')!;
    const unitEl = document.getElementById('slide-unit')!;
    const badgesEl = document.getElementById('slide-badges')!;
    const annotationEl = document.getElementById('slide-annotation')!;
    const counterEl = document.getElementById('slide-counter')!;
    const fillEl = document.getElementById('slide-progress-fill')!;
    const prevBtn = document.getElementById('slide-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('slide-next') as HTMLButtonElement;
    const playBtn = document.getElementById('slide-playpause') as HTMLButtonElement;
    const slideshowCard = document.getElementById('slideshow-card')!;

    let currentIndex = 0;
    let isPlaying = false;

    function formatDate(raw: string): string {
        const d = new Date(`${raw}T00:00:00`);
        if (isNaN(d.getTime())) return raw;
        return d.toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
    }

    function round2(n: number): number {
        return Math.round(n * 100) / 100;
    }

    function updatePlayButton() {
        playBtn.innerHTML = isPlaying ? '&#10074;&#10074;' : '&#9654;';
        playBtn.setAttribute('aria-label', isPlaying ? 'Pause' : 'Play');
    }

    function restartProgress() {
        fillEl.style.animation = 'none';
        void fillEl.offsetWidth;
        fillEl.style.animation = 'slide-fill 10s linear forwards';
        fillEl.style.animationPlayState = isPlaying ? 'running' : 'paused';
    }

    function renderSlide(index: number) {
        currentIndex = index;
        const entry = entries[index];

        dateEl.textContent = formatDate(entry.entry_date);
        scoreEl.textContent = String(entry.score);
        unitEl.textContent = chartData.y_axis_label;
        counterEl.textContent = `Point ${index + 1} of ${entries.length}`;
        annotationEl.textContent = entry.annotation || 'No note for this entry.';
        annotationEl.classList.toggle('empty', !entry.annotation);

        const badges: string[] = [];
        if (index > 0) {
            const diff = round2(entry.score - entries[index - 1].score);
            if (diff > 0) badges.push(`<span class="badge badge-up">&#9650; +${diff} vs previous</span>`);
            else if (diff < 0) badges.push(`<span class="badge badge-down">&#9660; ${diff} vs previous</span>`);
            else badges.push(`<span class="badge badge-flat">&#9679; No change vs previous</span>`);
        }
        if (chartData.goal_score !== null) {
            const diff = round2(Math.abs(entry.score - chartData.goal_score));
            badges.push(`<span class="badge badge-goal">&#127919; ${diff} from goal</span>`);
        }
        if (entry.score === maxScore) badges.push(`<span class="badge badge-high">&#128200; Highest so far</span>`);
        if (entry.score === minScore) badges.push(`<span class="badge badge-low">&#128201; Lowest so far</span>`);
        badgesEl.innerHTML = badges.join('');

        setActivePoint(chartInstance, entries, index);
        restartProgress();
    }

    function goTo(index: number) {
        const n = entries.length;
        renderSlide(((index % n) + n) % n);
    }

    function togglePlay() {
        isPlaying = !isPlaying;
        updatePlayButton();
        fillEl.style.animationPlayState = isPlaying ? 'running' : 'paused';
    }

    fillEl.addEventListener('animationend', () => {
        if (isPlaying) goTo(currentIndex + 1);
    });

    prevBtn.addEventListener('click', () => goTo(currentIndex - 1));
    nextBtn.addEventListener('click', () => goTo(currentIndex + 1));
    playBtn.addEventListener('click', togglePlay);

    window.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement)?.tagName === 'BUTTON') return;
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(currentIndex - 1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); goTo(currentIndex + 1); }
        else if (e.code === 'Space') { e.preventDefault(); togglePlay(); }
    });

    // Swipe on the info card (not the chart itself, which already scrolls
    // horizontally to page through dense charts) to move between points.
    let touchStartX = 0;
    slideshowCard.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    slideshowCard.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) goTo(currentIndex + (dx < 0 ? 1 : -1));
    });

    renderSlide(0);
}
</script>

<style>
h1 { margin: 0; font-size: 1.3rem; }
.focus-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    gap: 1rem;
}
.goal-line { color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0.25rem 0 0; }
.focus-actions { display: flex; gap: 0.6rem; flex-shrink: 0; }
.focus-card { padding: 0.85rem; }
.chart-shell { position: relative; }
.focus-chart-wrap { height: 240px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.chart-sizer { position: relative; height: 100%; min-width: 100%; }
.chart-nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: #fff;
    color: var(--primary);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12);
}
.chart-nav:hover { background: #f5f8f5; }
.chart-nav.visible { display: flex; }
.chart-nav-left { left: 4px; }
.chart-nav-right { right: 4px; }

.slideshow-card { margin-top: 0.75rem; padding: 0.9rem 1.25rem; text-align: center; }
.slide-progress { width: 100%; height: 5px; background: var(--border); border-radius: 999px; overflow: hidden; margin-bottom: 0.4rem; }
.slide-progress-fill { height: 100%; width: 0%; background: var(--accent); border-radius: 999px; }
.slide-counter { color: var(--text-light); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.4rem; }
.slide-date { font-size: 1.05rem; font-weight: 700; color: var(--primary); margin: 0 0 0.15rem; }
.slide-score-row { display: flex; align-items: baseline; justify-content: center; gap: 0.4rem; margin-bottom: 0.35rem; }
.slide-score { font-size: 2.4rem; font-weight: 800; color: var(--text); line-height: 1; }
.slide-unit { font-size: 0.95rem; color: var(--text-light); font-weight: 600; }
.slide-badges { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; margin-bottom: 0.5rem; }
.badge { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.74rem; font-weight: 700; background: #f0f3f0; color: var(--text); }
.badge-up { background: #d1fae5; color: #065f46; }
.badge-down { background: #fee2e2; color: #991b1b; }
.badge-flat { background: #f0f3f0; color: var(--text-light); }
.badge-goal { background: #fdf3d9; color: #92660a; }
.badge-high { background: #dbeafe; color: #1e40af; }
.badge-low { background: #ede9fe; color: #5b21b6; }
.slide-annotation { font-size: 1.1rem; line-height: 1.35; color: var(--text); max-width: 640px; margin: 0 auto; font-weight: 500; }
.slide-annotation.empty { color: var(--text-light); font-style: italic; font-weight: 400; }
.slide-controls { display: flex; align-items: center; justify-content: center; gap: 0.9rem; margin-top: 0.75rem; }
.slide-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--primary);
    font-size: 1.1rem;
    cursor: pointer;
}
.slide-btn:hover { background: #f5f8f5; }
.slide-btn-primary { width: 48px; height: 48px; background: var(--primary); color: #fff; border-color: var(--primary); font-size: 1.2rem; }
.slide-btn-primary:hover { opacity: 0.9; background: var(--primary); }

@media (max-width: 640px) {
    .focus-chart-wrap { height: 170px; }
    .focus-card { padding: 0.6rem; }
    .focus-header { flex-direction: column; }
    .slide-score { font-size: 2rem; }
    .slide-annotation { font-size: 1rem; }
    .slideshow-card { padding: 0.75rem 0.9rem; }
}
</style>

<style is:global>
@keyframes slide-fill {
    from { width: 0%; }
    to { width: 100%; }
}
</style>
