---
import Layout from '../../layouts/Layout.astro';
import { CHART_COLORS, DEFAULT_CHART_COLOR } from '../../lib/chart-colors';
---

<Layout title="New Chart | Chart Tracker">
    <div class="top-bar">
        <h1>New Chart</h1>
        <a href="/">&larr; Back</a>
    </div>

    <div class="card">
        <form id="chart-form">
            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" required placeholder="e.g., Mood Tracker" />
            </div>

            <div class="form-group">
                <label>Chart Type *</label>
                <div class="type-picker">
                    <label class="type-option">
                        <input type="radio" name="value_type" value="number" checked />
                        <span>Dates &amp; Numbers</span>
                    </label>
                    <label class="type-option">
                        <input type="radio" name="value_type" value="money" />
                        <span>Dates &amp; Money</span>
                    </label>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="x_axis_label">X-Axis Label *</label>
                    <input type="text" id="x_axis_label" name="x_axis_label" required placeholder="e.g., Date" value="Date" />
                </div>
                <div class="form-group">
                    <label for="y_axis_label">Y-Axis Label *</label>
                    <input type="text" id="y_axis_label" name="y_axis_label" required placeholder="e.g., Score" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="y_min">Y-Axis Min *</label>
                    <input type="number" id="y_min" name="y_min" required value="1" step="any" />
                </div>
                <div class="form-group">
                    <label for="y_max">Y-Axis Max *</label>
                    <input type="number" id="y_max" name="y_max" required value="100" step="any" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="date_start">Start Date *</label>
                    <input type="date" id="date_start" name="date_start" required />
                </div>
                <div class="form-group">
                    <label for="date_end">End Date *</label>
                    <input type="date" id="date_end" name="date_end" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="goal_score">Goal Score (optional)</label>
                    <input type="number" id="goal_score" name="goal_score" step="any" placeholder="e.g., 90" />
                </div>
                <div class="form-group">
                    <label for="goal_date">Goal Date (optional)</label>
                    <input type="date" id="goal_date" name="goal_date" />
                </div>
            </div>

            <div class="form-group">
                <label>Accent Color</label>
                <div class="color-picker">
                    {CHART_COLORS.map(c => (
                        <label class="color-swatch">
                            <input type="radio" name="color" value={c.hex} checked={c.hex === DEFAULT_CHART_COLOR} />
                            <span style={`background:${c.hex}`} title={c.name}></span>
                        </label>
                    ))}
                </div>
            </div>

            <button type="submit" class="btn">Create Chart</button>
            <div id="status-message" class="status-message"></div>
        </form>
    </div>
</Layout>

<script>
    const form = document.getElementById('chart-form') as HTMLFormElement;
    const statusMessage = document.getElementById('status-message')!;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/api/charts/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                const result = await response.json();
                window.location.href = `/charts/${result.id}`;
            } else {
                const error = await response.json();
                statusMessage.textContent = `Error: ${error.error || 'Failed to create chart'}`;
                statusMessage.className = 'status-message error';
            }
        } catch {
            statusMessage.textContent = 'Network error. Please try again.';
            statusMessage.className = 'status-message error';
        }
    });
</script>

<style>
.color-picker { display: flex; gap: 0.7rem; }
.color-swatch { position: relative; cursor: pointer; }
.color-swatch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.color-swatch span {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.15s;
}
.color-swatch input:checked + span { outline-color: var(--text); }
.color-swatch input:focus-visible + span { outline-color: var(--primary); }

.type-picker { display: flex; gap: 0.6rem; }
.type-option { position: relative; }
.type-option input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.type-option span {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.type-option input:checked + span { border-color: var(--primary); background: #eef4ee; color: var(--primary); }
.type-option input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }
</style>
