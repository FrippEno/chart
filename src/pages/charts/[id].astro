---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db/client';
import { getChartById, getEntriesForChart } from '../../lib/db/chart-queries';
import { formatMetric } from '../../lib/format';
import { getAuthenticatedUser } from '../../lib/auth';

const { id } = Astro.params;
const chartId = Number(id);
const db = getDB(Astro.locals.runtime?.env);
const chart = await getChartById(db, chartId);

if (!chart) {
    return Astro.redirect('/');
}

// This page is reachable without logging in (see middleware.ts) so shared
// links work for anyone. Editing controls only render for the signed-in
// admin — the write APIs stay auth-gated either way, but showing buttons
// that would just 401 for an anonymous visitor is confusing.
const user = await getAuthenticatedUser(Astro.request, Astro.locals.runtime?.env);
const isAuthed = !!user && user.is_admin === 1;

const entries = await getEntriesForChart(db, chartId);
const latest = entries.length > 0 ? entries[entries.length - 1] : null;
const goalDiff = chart.goal_score !== null && latest ? Math.abs(latest.score - chart.goal_score) : null;
const fmt = (n: number) => formatMetric(n, chart.y_axis_label);

const pointCount = `${entries.length} data point${entries.length === 1 ? '' : 's'}`;
const description = chart.goal_score !== null && latest
    ? `${pointCount} · Latest ${chart.y_axis_label}: ${fmt(latest.score)} · Goal: ${fmt(chart.goal_score)}`
    : latest
        ? `${pointCount} · Latest ${chart.y_axis_label}: ${fmt(latest.score)}`
        : `${chart.x_axis_label} vs ${chart.y_axis_label}, ${chart.date_start} to ${chart.date_end}`;
---

<Layout title={`${chart.title} | Chart Tracker`} description={description}>
    <div class="top-bar">
        <div>
            <h1>{chart.title}</h1>
            <p class="subtitle">{chart.date_start} &ndash; {chart.date_end} &middot; {chart.y_axis_label} range {fmt(chart.y_min)}&ndash;{fmt(chart.y_max)}</p>
            {chart.goal_score !== null && (
                <p class="goal-line">
                    &#127919; Goal: {fmt(chart.goal_score)}{chart.goal_date && <> by {chart.goal_date}</>}
                    {latest && <> &middot; Latest: {fmt(latest.score)} ({fmt(goalDiff!)} from goal)</>}
                </p>
            )}
        </div>
        <div class="top-actions">
            {isAuthed && <a href="/" class="btn btn-secondary">All Charts</a>}
            <a href={`/charts/${chart.id}/focus`} class="btn btn-secondary" target="_blank" rel="noopener">Focus View</a>
            {isAuthed && <a href={`/charts/edit/${chart.id}`} class="btn btn-secondary">Edit</a>}
        </div>
    </div>

    <div class="card">
        <div class="chart-shell">
            <button type="button" class="chart-nav chart-nav-left" id="chart-nav-left" aria-label="Scroll chart left">&#8249;</button>
            <div class="chart-wrap">
                <div class="chart-sizer">
                    <canvas id="chart-canvas"></canvas>
                </div>
            </div>
            <button type="button" class="chart-nav chart-nav-right" id="chart-nav-right" aria-label="Scroll chart right">&#8250;</button>
        </div>
    </div>

    {isAuthed && (
        <div class="card" style="margin-top: 1.5rem;">
            <h2 class="section-h">Add Data Point</h2>
            <form id="entry-form">
                <input type="hidden" name="chart_id" value={chart.id} />
                <div class="form-row">
                    <div class="form-group">
                        <label for="entry_date">{chart.x_axis_label}</label>
                        <input type="date" id="entry_date" name="entry_date" required min={chart.date_start} max={chart.date_end} />
                    </div>
                    <div class="form-group">
                        <label for="score">{chart.y_axis_label}</label>
                        <input type="number" id="score" name="score" required min={chart.y_min} max={chart.y_max} step="any" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="annotation">Annotation (optional)</label>
                    <textarea id="annotation" name="annotation" rows="2" placeholder="Note about this data point..."></textarea>
                </div>
                <button type="submit" class="btn">Add Point</button>
                <div id="add-status" class="status-message"></div>
            </form>
        </div>

        <div class="card" style="margin-top: 1.5rem;">
            <h2 class="section-h">Bulk Import</h2>
            <p class="hint">CSV with a header row: <code>date,score,annotation</code> (annotation column is optional). Paste it below or choose a file &mdash; either works.</p>
            <div class="form-group">
                <input type="file" id="csv-file" accept=".csv,text/csv" />
            </div>
            <div class="form-group">
                <textarea id="csv-text" rows="5" placeholder={`date,score,annotation\n${chart.date_start},50,\n${chart.date_end},72,Felt great today`}></textarea>
            </div>
            <button type="button" id="preview-btn" class="btn btn-secondary">Preview</button>
            <button type="button" id="import-btn" class="btn" style="display: none; margin-left: 0.75rem;">Import Points</button>
            <div id="import-status" class="status-message"></div>
            <div id="csv-preview"></div>
        </div>
    )}

    <div class="card" style="margin-top: 1.5rem;">
        <h2 class="section-h">Data Points</h2>
        {entries.length === 0 ? (
            <p style="color: var(--text-light); margin: 0;">No data points yet.</p>
        ) : (
            <div class="table-scroll">
                <table id="entries-table">
                    <thead>
                        <tr>
                            <th>{chart.x_axis_label}</th>
                            <th>{chart.y_axis_label}</th>
                            <th>Annotation</th>
                            {isAuthed && <th></th>}
                        </tr>
                    </thead>
                    <tbody>
                        {entries.map(e => (
                            <tr data-id={e.id}>
                                <td class="cell-date">{e.entry_date}</td>
                                <td class="cell-score" data-score={e.score}>{fmt(e.score)}</td>
                                <td class="cell-annotation">{e.annotation || ''}</td>
                                {isAuthed && (
                                    <td class="cell-actions">
                                        <button type="button" class="link-btn edit-entry">Edit</button>
                                        <button type="button" class="link-btn delete-entry">Delete</button>
                                    </td>
                                )}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        )}
    </div>
</Layout>

<script define:vars={{ chart, entries }}>
    window.__CHART_DATA__ = chart;
    window.__CHART_ENTRIES__ = entries;
</script>

<script>
import Papa from 'papaparse';
import { renderChart } from '../../lib/render-chart';

const chartData = (window as any).__CHART_DATA__;
const entries = (window as any).__CHART_ENTRIES__;

const canvas = document.getElementById('chart-canvas') as HTMLCanvasElement;
renderChart(canvas, chartData, entries);

// ── Add entry ─────────────────────────────────────────────────────────
// These elements only exist in the markup for the signed-in admin — an
// anonymous viewer on a shared link doesn't get them at all.
const entryForm = document.getElementById('entry-form') as HTMLFormElement | null;
const addStatus = document.getElementById('add-status');

entryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(entryForm);
    const data = Object.fromEntries(formData.entries());

    try {
        const response = await fetch('/api/charts/entries/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
        });

        if (response.ok) {
            window.location.reload();
        } else {
            const error = await response.json();
            addStatus!.textContent = `Error: ${error.error || 'Failed to add point'}`;
            addStatus!.className = 'status-message error';
        }
    } catch {
        addStatus!.textContent = 'Network error. Please try again.';
        addStatus!.className = 'status-message error';
    }
});

// ── Bulk import ───────────────────────────────────────────────────────
const csvFileInput = document.getElementById('csv-file') as HTMLInputElement | null;
const csvTextArea = document.getElementById('csv-text') as HTMLTextAreaElement | null;
const previewBtn = document.getElementById('preview-btn') as HTMLButtonElement | null;
const importBtn = document.getElementById('import-btn') as HTMLButtonElement | null;
const importStatus = document.getElementById('import-status');
const csvPreview = document.getElementById('csv-preview');

let pendingImport: { entry_date: string; score: number; annotation: string | null }[] = [];

csvFileInput?.addEventListener('change', async () => {
    const file = csvFileInput.files?.[0];
    if (!file) return;
    csvTextArea!.value = await file.text();
});

const DATE_ALIASES = ['date', 'x', chartData.x_axis_label.toLowerCase()];
const SCORE_ALIASES = ['score', 'y', 'value', chartData.y_axis_label.toLowerCase()];
const ANNOTATION_ALIASES = ['annotation', 'note', 'notes'];

function normalizeDate(raw: string): string | null {
    const trimmed = raw.trim();
    if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) return trimmed;
    const parsed = new Date(trimmed);
    if (isNaN(parsed.getTime())) return null;
    return parsed.toISOString().slice(0, 10);
}

previewBtn?.addEventListener('click', () => {
    importStatus!.className = 'status-message';
    importStatus!.textContent = '';
    importBtn!.style.display = 'none';
    pendingImport = [];

    const csvText = csvTextArea!.value.trim();
    if (!csvText) {
        csvPreview!.innerHTML = '<p class="hint">Nothing to preview yet.</p>';
        return;
    }

    const parsed = Papa.parse(csvText, {
        header: true,
        skipEmptyLines: true,
        transformHeader: (h: string) => h.trim().toLowerCase(),
    });

    const rows: { date: string; score: string; annotation: string; error: string }[] = [];
    const valid: { entry_date: string; score: number; annotation: string | null }[] = [];

    for (const raw of parsed.data as Record<string, string>[]) {
        const dateKey = Object.keys(raw).find(k => DATE_ALIASES.includes(k));
        const scoreKey = Object.keys(raw).find(k => SCORE_ALIASES.includes(k));
        const annotationKey = Object.keys(raw).find(k => ANNOTATION_ALIASES.includes(k));

        const dateRaw = dateKey ? raw[dateKey] : '';
        const scoreRaw = scoreKey ? raw[scoreKey] : '';
        const annotationRaw = annotationKey ? raw[annotationKey] : '';

        const normalizedDate = dateRaw ? normalizeDate(dateRaw) : null;
        const score = Number(scoreRaw);

        let error = '';
        if (!dateRaw) error = 'missing date';
        else if (!normalizedDate) error = `unrecognized date: ${dateRaw}`;
        else if (!scoreRaw) error = 'missing score';
        else if (Number.isNaN(score)) error = `invalid score: ${scoreRaw}`;

        rows.push({ date: dateRaw, score: scoreRaw, annotation: annotationRaw, error });

        if (!error && normalizedDate) {
            valid.push({ entry_date: normalizedDate, score, annotation: annotationRaw || null });
        }
    }

    if (rows.length === 0) {
        csvPreview!.innerHTML = '<p class="hint">No rows found. Make sure the first row is a header: date,score,annotation</p>';
        return;
    }

    const rowsHtml = rows.map(r => `
        <tr class="${r.error ? 'row-error' : ''}">
            <td>${r.date || '&mdash;'}</td>
            <td>${r.score || '&mdash;'}</td>
            <td>${r.annotation || ''}</td>
            <td>${r.error ? `&#9888; ${r.error}` : '&#10003;'}</td>
        </tr>
    `).join('');

    csvPreview!.innerHTML = `
        <table class="preview-table">
            <thead><tr><th>Date</th><th>Score</th><th>Annotation</th><th>Status</th></tr></thead>
            <tbody>${rowsHtml}</tbody>
        </table>
        <p class="hint">${valid.length} of ${rows.length} row(s) ready to import.</p>
    `;

    pendingImport = valid;
    if (valid.length > 0) {
        importBtn!.style.display = 'inline-block';
        importBtn!.textContent = `Import ${valid.length} Point${valid.length === 1 ? '' : 's'}`;
    }
});

importBtn?.addEventListener('click', async () => {
    if (pendingImport.length === 0) return;

    try {
        const response = await fetch('/api/charts/entries/bulk-create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chart_id: chartData.id, entries: pendingImport }),
        });

        if (response.ok) {
            window.location.reload();
        } else {
            const error = await response.json();
            importStatus!.textContent = `Error: ${error.error || 'Failed to import'}`;
            importStatus!.className = 'status-message error';
        }
    } catch {
        importStatus!.textContent = 'Network error. Please try again.';
        importStatus!.className = 'status-message error';
    }
});

// ── Edit / delete entries ────────────────────────────────────────────
document.querySelectorAll('.delete-entry').forEach(btn => {
    btn.addEventListener('click', async () => {
        const row = (btn as HTMLElement).closest('tr')!;
        const id = Number(row.dataset.id);
        if (!confirm('Delete this data point?')) return;

        const response = await fetch('/api/charts/entries/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
        });

        if (response.ok) {
            window.location.reload();
        } else {
            alert('Failed to delete data point.');
        }
    });
});

document.querySelectorAll('.edit-entry').forEach(btn => {
    btn.addEventListener('click', () => {
        const row = (btn as HTMLElement).closest('tr')!;
        if (row.classList.contains('editing')) return;
        row.classList.add('editing');

        const id = Number(row.dataset.id);
        const dateCell = row.querySelector('.cell-date')!;
        const scoreCell = row.querySelector('.cell-score')!;
        const annotationCell = row.querySelector('.cell-annotation')!;
        const actionsCell = row.querySelector('.cell-actions')!;

        const currentDate = dateCell.textContent!.trim();
        const currentScore = (scoreCell as HTMLElement).dataset.score!;
        const currentAnnotation = annotationCell.textContent!.trim();

        dateCell.innerHTML = `<input type="date" class="edit-date" value="${currentDate}" min="${chartData.date_start}" max="${chartData.date_end}" />`;
        scoreCell.innerHTML = `<input type="number" class="edit-score" value="${currentScore}" min="${chartData.y_min}" max="${chartData.y_max}" step="any" />`;
        annotationCell.innerHTML = `<input type="text" class="edit-annotation" value="${currentAnnotation}" />`;
        actionsCell.innerHTML = `<button type="button" class="link-btn save-entry">Save</button> <button type="button" class="link-btn cancel-entry">Cancel</button>`;

        actionsCell.querySelector('.cancel-entry')!.addEventListener('click', () => window.location.reload());
        actionsCell.querySelector('.save-entry')!.addEventListener('click', async () => {
            const entry_date = (row.querySelector('.edit-date') as HTMLInputElement).value;
            const score = (row.querySelector('.edit-score') as HTMLInputElement).value;
            const annotation = (row.querySelector('.edit-annotation') as HTMLInputElement).value;

            const response = await fetch('/api/charts/entries/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, entry_date, score, annotation }),
            });

            if (response.ok) {
                window.location.reload();
            } else {
                alert('Failed to save changes.');
            }
        });
    });
});
</script>

<style>
.top-bar { align-items: flex-start; }
.subtitle { color: var(--text-light); font-size: 0.85rem; margin: 0.15rem 0 0; }
.goal-line { color: var(--accent); font-size: 0.85rem; font-weight: 600; margin: 0.35rem 0 0; }
.top-actions { display: flex; gap: 0.6rem; flex-shrink: 0; }
.section-h { font-size: 1rem; color: var(--primary); margin: 0 0 1rem; }

.chart-shell { position: relative; }
.chart-wrap { height: 340px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.chart-sizer { position: relative; height: 100%; min-width: 100%; }
.chart-nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: #fff;
    color: var(--primary);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12);
}
.chart-nav:hover { background: #f5f8f5; }
.chart-nav.visible { display: flex; }
.chart-nav-left { left: 4px; }
.chart-nav-right { right: 4px; }

.table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-light); padding: 0.5rem 0.6rem; border-bottom: 2px solid var(--border); white-space: nowrap; }
td { padding: 0.55rem 0.6rem; border-bottom: 1px solid #f0f0f0; font-size: 0.9rem; }
tr:last-child td { border-bottom: none; }
.cell-annotation { color: var(--text-light); }
.link-btn { background: none; border: none; color: var(--accent); font-size: 0.82rem; font-weight: 600; cursor: pointer; padding: 0; margin-right: 0.75rem; white-space: nowrap; }
.link-btn:hover { text-decoration: underline; }
.editing input { padding: 0.35rem 0.5rem; font-size: 0.85rem; }
.hint { color: var(--text-light); font-size: 0.82rem; margin: 0 0 0.9rem; }
#csv-text { font-family: 'Courier New', monospace; font-size: 0.85rem; }
#csv-preview { margin-top: 1rem; }
.preview-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
.preview-table th { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 2px solid var(--border); color: var(--text-light); font-size: 0.75rem; text-transform: uppercase; }
.preview-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #f0f0f0; }
.preview-table tr.row-error { background: #fef2f2; color: #991b1b; }
@media (max-width: 640px) {
    .top-bar { flex-direction: column; gap: 1rem; }
    .chart-wrap { height: 260px; }
    .card { padding: 1rem 1rem; }
}
</style>
