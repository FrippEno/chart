---
import Layout from '../../../layouts/Layout.astro';
import { getDB } from '../../../lib/db/client';
import { getChartById } from '../../../lib/db/chart-queries';
import { CHART_COLORS, DEFAULT_CHART_COLOR } from '../../../lib/chart-colors';

const { id } = Astro.params;
const db = getDB(Astro.locals.runtime?.env);
const chart = await getChartById(db, Number(id));

if (!chart) {
    return Astro.redirect('/');
}

const currentColor = chart.color || DEFAULT_CHART_COLOR;
---

<Layout title={`Edit ${chart.title} | Chart Tracker`}>
    <div class="top-bar">
        <h1>Edit Chart</h1>
        <a href={`/charts/${chart.id}`}>&larr; Back</a>
    </div>

    <div class="card">
        <form id="chart-form">
            <input type="hidden" name="id" value={chart.id} />

            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" required value={chart.title} />
            </div>

            <div class="form-group">
                <label>Chart Type *</label>
                <div class="type-picker">
                    <label class="type-option">
                        <input type="radio" name="value_type" value="number" checked={chart.value_type !== 'money'} />
                        <span>Dates &amp; Numbers</span>
                    </label>
                    <label class="type-option">
                        <input type="radio" name="value_type" value="money" checked={chart.value_type === 'money'} />
                        <span>Dates &amp; Money</span>
                    </label>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="x_axis_label">X-Axis Label *</label>
                    <input type="text" id="x_axis_label" name="x_axis_label" required value={chart.x_axis_label} />
                </div>
                <div class="form-group">
                    <label for="y_axis_label">Y-Axis Label *</label>
                    <input type="text" id="y_axis_label" name="y_axis_label" required value={chart.y_axis_label} />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="y_min">Y-Axis Min *</label>
                    <input type="number" id="y_min" name="y_min" required value={chart.y_min} step="any" />
                </div>
                <div class="form-group">
                    <label for="y_max">Y-Axis Max *</label>
                    <input type="number" id="y_max" name="y_max" required value={chart.y_max} step="any" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="date_start">Start Date *</label>
                    <input type="date" id="date_start" name="date_start" required value={chart.date_start} />
                </div>
                <div class="form-group">
                    <label for="date_end">End Date *</label>
                    <input type="date" id="date_end" name="date_end" required value={chart.date_end} />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="goal_score">Goal Score (optional)</label>
                    <input type="number" id="goal_score" name="goal_score" step="any" value={chart.goal_score ?? ''} placeholder="e.g., 90" />
                </div>
                <div class="form-group">
                    <label for="goal_date">Goal Date (optional)</label>
                    <input type="date" id="goal_date" name="goal_date" value={chart.goal_date ?? ''} />
                </div>
            </div>

            <div class="form-group">
                <label>Accent Color</label>
                <div class="color-picker">
                    {CHART_COLORS.map(c => (
                        <label class="color-swatch">
                            <input type="radio" name="color" value={c.hex} checked={c.hex === currentColor} />
                            <span style={`background:${c.hex}`} title={c.name}></span>
                        </label>
                    ))}
                </div>
            </div>

            <button type="submit" class="btn">Save Changes</button>
            <button type="button" id="reset-data-btn" class="btn btn-danger" style="margin-left: 0.75rem;">Reset All Data</button>
            <button type="button" id="delete-btn" class="btn btn-danger" style="margin-left: 0.75rem;">Delete Chart</button>
            <div id="status-message" class="status-message"></div>
        </form>
    </div>
</Layout>

<script>
    const form = document.getElementById('chart-form') as HTMLFormElement;
    const statusMessage = document.getElementById('status-message')!;
    const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;
    const resetDataBtn = document.getElementById('reset-data-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/api/charts/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                window.location.href = `/charts/${data.id}`;
            } else {
                const error = await response.json();
                statusMessage.textContent = `Error: ${error.error || 'Failed to update chart'}`;
                statusMessage.className = 'status-message error';
            }
        } catch {
            statusMessage.textContent = 'Network error. Please try again.';
            statusMessage.className = 'status-message error';
        }
    });

    resetDataBtn.addEventListener('click', async () => {
        if (!confirm('Delete all data points on this chart? The chart itself will stay, but this cannot be undone.')) return;
        const chart_id = Number(new FormData(form).get('id'));

        try {
            const response = await fetch('/api/charts/entries/clear', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chart_id }),
            });

            if (response.ok) {
                statusMessage.textContent = 'All data points have been removed.';
                statusMessage.className = 'status-message success';
            } else {
                const error = await response.json();
                statusMessage.textContent = `Error: ${error.error || 'Failed to reset chart data'}`;
                statusMessage.className = 'status-message error';
            }
        } catch {
            statusMessage.textContent = 'Network error. Please try again.';
            statusMessage.className = 'status-message error';
        }
    });

    deleteBtn.addEventListener('click', async () => {
        if (!confirm('Delete this chart and all its data points? This cannot be undone.')) return;
        const id = Number(new FormData(form).get('id'));

        try {
            const response = await fetch('/api/charts/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id }),
            });

            if (response.ok) {
                window.location.href = '/';
            } else {
                const error = await response.json();
                statusMessage.textContent = `Error: ${error.error || 'Failed to delete chart'}`;
                statusMessage.className = 'status-message error';
            }
        } catch {
            statusMessage.textContent = 'Network error. Please try again.';
            statusMessage.className = 'status-message error';
        }
    });
</script>

<style>
.color-picker { display: flex; gap: 0.7rem; }
.color-swatch { position: relative; cursor: pointer; }
.color-swatch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.color-swatch span {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.15s;
}
.color-swatch input:checked + span { outline-color: var(--text); }
.color-swatch input:focus-visible + span { outline-color: var(--primary); }

.type-picker { display: flex; gap: 0.6rem; }
.type-option { position: relative; }
.type-option input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.type-option span {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
}
.type-option input:checked + span { border-color: var(--primary); background: #eef4ee; color: var(--primary); }
.type-option input:focus-visible + span { outline: 2px solid var(--primary); outline-offset: 2px; }
</style>
