---
import Layout from '../../../layouts/Layout.astro';
import { getDB } from '../../../lib/db/client';
import { getChartById } from '../../../lib/db/chart-queries';

const { id } = Astro.params;
const db = getDB(Astro.locals.runtime?.env);
const chart = await getChartById(db, Number(id));

if (!chart) {
    return Astro.redirect('/');
}
---

<Layout title={`Edit ${chart.title} | Chart Tracker`}>
    <div class="top-bar">
        <h1>Edit Chart</h1>
        <a href={`/charts/${chart.id}`}>&larr; Back</a>
    </div>

    <div class="card">
        <form id="chart-form">
            <input type="hidden" name="id" value={chart.id} />

            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" required value={chart.title} />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="x_axis_label">X-Axis Label *</label>
                    <input type="text" id="x_axis_label" name="x_axis_label" required value={chart.x_axis_label} />
                </div>
                <div class="form-group">
                    <label for="y_axis_label">Y-Axis Label *</label>
                    <input type="text" id="y_axis_label" name="y_axis_label" required value={chart.y_axis_label} />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="y_min">Y-Axis Min *</label>
                    <input type="number" id="y_min" name="y_min" required value={chart.y_min} step="any" />
                </div>
                <div class="form-group">
                    <label for="y_max">Y-Axis Max *</label>
                    <input type="number" id="y_max" name="y_max" required value={chart.y_max} step="any" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="date_start">Start Date *</label>
                    <input type="date" id="date_start" name="date_start" required value={chart.date_start} />
                </div>
                <div class="form-group">
                    <label for="date_end">End Date *</label>
                    <input type="date" id="date_end" name="date_end" required value={chart.date_end} />
                </div>
            </div>

            <button type="submit" class="btn">Save Changes</button>
            <button type="button" id="delete-btn" class="btn btn-danger" style="margin-left: 0.75rem;">Delete Chart</button>
            <div id="status-message" class="status-message"></div>
        </form>
    </div>
</Layout>

<script>
    const form = document.getElementById('chart-form') as HTMLFormElement;
    const statusMessage = document.getElementById('status-message')!;
    const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/api/charts/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                window.location.href = `/charts/${data.id}`;
            } else {
                const error = await response.json();
                statusMessage.textContent = `Error: ${error.error || 'Failed to update chart'}`;
                statusMessage.className = 'status-message error';
            }
        } catch {
            statusMessage.textContent = 'Network error. Please try again.';
            statusMessage.className = 'status-message error';
        }
    });

    deleteBtn.addEventListener('click', async () => {
        if (!confirm('Delete this chart and all its data points? This cannot be undone.')) return;
        const id = Number(new FormData(form).get('id'));

        try {
            const response = await fetch('/api/charts/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id }),
            });

            if (response.ok) {
                window.location.href = '/';
            } else {
                const error = await response.json();
                statusMessage.textContent = `Error: ${error.error || 'Failed to delete chart'}`;
                statusMessage.className = 'status-message error';
            }
        } catch {
            statusMessage.textContent = 'Network error. Please try again.';
            statusMessage.className = 'status-message error';
        }
    });
</script>
